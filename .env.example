# The public URL of your Supabase project.
SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase secret. Never expose this as a Vite VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Storage bucket created by supabase/schema.sql.
SUPABASE_STORAGE_BUCKET=surprise-media

# Bcrypt hash for the private owner dashboard password. Generate it with:
# node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "your-owner-password"
ADMIN_PASSWORD_HASH=

# Optional port used by the local Express server. Vercel sets its own runtime port.
PORT=3001

# Public frontend settings; never put server secrets in VITE_ variables.
VITE_PUBLIC_ORIGIN=https://dearli.vercel.app
VITE_API_ORIGIN=https://dearli.vercel.app
MOBILE_ALLOWED_ORIGINS=https://localhost
