# The public URL of your Supabase project.
SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase secret. Never expose this as a Vite VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Storage bucket created by supabase/schema.sql.
SUPABASE_STORAGE_BUCKET=surprise-media

# Port used by the Express API in a self-hosted deployment.
PORT=3001
